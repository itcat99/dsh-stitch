{
  "name": "dsh-stitch",
  "version": "0.1.0",
  "private": true,
  "description": "Google Stitch for DSH: settings-panel API key/OAuth setup, Stitch MCP tools, and the official Stitch Agent Skills.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**",
    "skills/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-0 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-credentials": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/stitch.js && node --check lib/skills.js && node --check lib/tool-specs.js",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "google-stitch",
    "mcp",
    "ui-design",
    "agent-skills"
  ],
  "license": "MIT"
}
